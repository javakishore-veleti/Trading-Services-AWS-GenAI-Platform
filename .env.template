# Copy this file to .env. Defaults below match the local compose files.
# Replace the three secrets. Do not commit .env. LITELLM_SALT_KEY cannot be rotated
# after provider keys are stored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=redis
REDIS_PORT=6379

LITELLM_PORT=4000
NUM_WORKERS=1
LITELLM_LOG=INFO
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me-and-never-rotate

# Admin UI login. The username is this email.
UI_ADMIN_EMAIL=admin@localhost
UI_ADMIN_PASSWORD='change-me-Change-me-1!'

# Same model as stages/11-vllm-model. The vLLM image needs an NVIDIA GPU.
VLLM_PORT=8000
VLLM_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
VLLM_SERVED_MODEL_NAME=deepseek-r1-qwen3-8b
# Optional. The model is public. Set this for a higher Hugging Face download limit.
# HF_TOKEN=

# Lens. Generate each secret with: openssl rand -hex 32
# Do not reuse one value for another. LENS_ADMIN_TOKEN signs into http://127.0.0.1:4318/ui
LENS_PORT=4318
LENS_IMAGE=lens:local
CLICKHOUSE_PASSWORD=change-me
LENS_ADMIN_TOKEN=change-me
LITELLM_LENS_SERVICE_TOKEN=change-me
LENS_GATEWAY_SECRET=change-me
