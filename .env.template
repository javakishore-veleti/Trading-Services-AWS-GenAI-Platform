# Copy this file to .env. Defaults below match the local compose files.
# Replace every change-me value. Do not commit .env. LITELLM_SALT_KEY cannot be rotated
# after provider keys are stored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=redis
REDIS_PORT=6379

PGVECTOR_USER=pgvector
PGVECTOR_PASSWORD=pgvector
PGVECTOR_DB=pgvector
PGVECTOR_PORT=5433
PGVECTOR_CONNECTOR_PORT=8001
# Generated on first startup. Lets the connector read the team catalog.
PGVECTOR_ROUTER_PASSWORD=change-me
PGVECTOR_EMBEDDING_MODEL=text-embedding-3-small
PGVECTOR_EMBEDDING_DIMENSIONS=1536

LITELLM_PORT=4000
NUM_WORKERS=1
LITELLM_LOG=INFO
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me-and-never-rotate

# Admin UI login. The username is this email.
UI_ADMIN_EMAIL=admin@localhost
UI_ADMIN_PASSWORD='change-me-Change-me-1!'

# Same model as stages/11-vllm-model. The vLLM image needs an NVIDIA GPU.
VLLM_PORT=8000
VLLM_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
VLLM_SERVED_MODEL_NAME=deepseek-r1-qwen3-8b
# Same image constraint as vLLM. Not started on this Mac.
SGLANG_PORT=30000
SGLANG_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
# Optional. The model is public. Set this for a higher Hugging Face download limit.
# HF_TOKEN=

# false: a proxy named ollama forwards to Ollama on this computer.
# true: the Ollama container is that name. LiteLLM always calls http://ollama:11434.
OLLAMA_ENABLED=false
OLLAMA_PULL=true
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_PORT=11434

# Embedding container. bge-small fits this Mac. The vector is 384 numbers.
TEI_PORT=8080
TEI_MODEL=BAAI/bge-small-en-v1.5
TEI_EMBEDDING_DIM=384

# Langfuse and Phoenix stay off until the matching flag is true.
# Langfuse uses the platform Postgres database langfuse and the platform Redis.
# Port 3000 is the Langfuse UI. Open WebUI uses 3001.
# Open WebUI stays off until OPENWEBUI_ENABLED is true.
LANGFUSE_ENABLED=false
PHOENIX_ENABLED=false
OPENWEBUI_ENABLED=false
# n8n stays off until N8N_ENABLED is true. It uses the platform Postgres database n8n.
N8N_ENABLED=false
LANGFUSE_PORT=3000
PHOENIX_PORT=6006
N8N_PORT=5678

OPENWEBUI_PORT=3001
OPENWEBUI_ADMIN_EMAIL=admin@example.com
OPENWEBUI_ADMIN_PASSWORD=openwebui

# Bedrock from LiteLLM. Leave the keys empty to skip. Region stays us-east-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Lens. Generate each secret with: openssl rand -hex 32
# Do not reuse one value for another. LENS_ADMIN_TOKEN signs into http://127.0.0.1:4318/ui
LENS_PORT=4318
LENS_IMAGE=lens:local
CLICKHOUSE_PASSWORD=change-me
LENS_ADMIN_TOKEN=change-me
LITELLM_LENS_SERVICE_TOKEN=change-me
LENS_GATEWAY_SECRET=change-me
