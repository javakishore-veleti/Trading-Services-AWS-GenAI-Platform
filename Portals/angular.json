{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "trading-desk": {
      "projectType": "application",
      "root": "projects/trading-desk",
      "sourceRoot": "projects/trading-desk/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/trading-desk",
            "index": "projects/trading-desk/src/index.html",
            "browser": "projects/trading-desk/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/trading-desk/tsconfig.app.json",
            "styles": ["projects/trading-desk/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [{"type": "initial", "maximumWarning": "500kb", "maximumError": "1mb"}],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {"host": "127.0.0.1", "port": 4200},
          "configurations": {
            "development": {"buildTarget": "trading-desk:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "admin": {
      "projectType": "application",
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/admin",
            "index": "projects/admin/src/index.html",
            "browser": "projects/admin/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/admin/tsconfig.app.json",
            "styles": ["projects/admin/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [{"type": "initial", "maximumWarning": "500kb", "maximumError": "1mb"}],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {"host": "127.0.0.1", "port": 4201},
          "configurations": {
            "development": {"buildTarget": "admin:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
